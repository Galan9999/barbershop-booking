# Copia este fichero a .env.local y rellénalo.
# Guía paso a paso: docs/SETUP-PRODUCCION.md

# --- App ---
# URL pública: destino del QR y base de los enlaces del email. Sin barra final.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Zona horaria IANA en la que opera el negocio.
BUSINESS_TIMEZONE=Europe/Madrid

# --- Supabase (solo servidor) ---
# Project Settings > API. La service_role es secreta: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Email ---
# "resend" envía de verdad; "console" escribe el correo en .dev-emails/ y no envía nada.
EMAIL_TRANSPORT=console
RESEND_API_KEY=re_...
# Remitente. Sin dominio verificado: "Barbería Central <onboarding@resend.dev>".
EMAIL_FROM="Barbería Central <citas@example.com>"
