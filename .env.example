# --- App ---
# Public base URL (QR target and email links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# IANA timezone the business operates in.
BUSINESS_TIMEZONE=Europe/Madrid

# --- Supabase (server-only) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # NEVER expose with NEXT_PUBLIC_

# --- Email (Resend) ---
RESEND_API_KEY=re_...
# Verified sender, e.g. "Barbería Central <citas@yourdomain.com>"
EMAIL_FROM="Barbería Central <citas@example.com>"
