# Copia este fichero a .env.local y rellénalo.
# Guía completa: docs/PERSONALIZAR.md

# --- Identidad de la peluquería ---
BUSINESS_NAME="Barbería Central"
BUSINESS_ADDRESS="Calle Mayor 1, Madrid"
BUSINESS_BARBERS="Carlos, Miguel"
BUSINESS_TIMEZONE=Europe/Madrid

# --- Horarios (JSON en una línea; 0 = domingo, null = cerrado) ---
BUSINESS_OPENING_HOURS={"0":null,"1":{"open":"09:00","close":"20:00"},"2":{"open":"09:00","close":"20:00"},"3":{"open":"09:00","close":"20:00"},"4":{"open":"09:00","close":"20:00"},"5":{"open":"09:00","close":"20:00"},"6":{"open":"09:00","close":"14:00"}}

# --- Duraciones (la cita debe ser múltiplo del hueco) ---
BUSINESS_SLOT_MINUTES=30
BUSINESS_MIN_ADVANCE_MINUTES=60
BUSINESS_MAX_ADVANCE_DAYS=30

# --- Servicios (JSON en una línea; minutos múltiplo del hueco, precio en euros) ---
BUSINESS_SERVICES=[{"id":"haircut","label":"Corte de pelo","minutes":30,"price":15},{"id":"beard","label":"Barba","minutes":30,"price":15},{"id":"haircut_beard","label":"Corte y barba","minutes":60,"price":30}]
BUSINESS_PAYMENT_NOTE="Se paga en efectivo en la barbería."
# Opcional: sale en el correo de confirmación y en la pantalla final.
BUSINESS_PHONE="931 92 40 60"

# --- Colores y tipografía ---
BUSINESS_COLOR_ACCENT=#7c2d12
BUSINESS_COLOR_ACCENT_HOVER=#9a3412
BUSINESS_COLOR_ACCENT_SOFT=#fdf3ec
BUSINESS_COLOR_BACKGROUND=#faf8f5
BUSINESS_FONT_DISPLAY="Georgia, 'Times New Roman', serif"

# --- App ---
# URL pública real: va dentro de los enlaces de cancelación. Sin barra final.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (solo servidor) ---
# Project Settings > API. Hace falta la clave SECRET, no la publishable.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Email ---
# "resend" envía de verdad; "console" escribe el correo en .dev-emails/.
EMAIL_TRANSPORT=console
RESEND_API_KEY=re_...
EMAIL_FROM="Barbería Central <citas@example.com>"
# Dónde recibe la peluquería cada cita, con la invitación de calendario adjunta.
BUSINESS_EMAIL=barberia@example.com
